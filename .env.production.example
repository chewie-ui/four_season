# =====================================================================
#  FOUR SEASON — configuration de PRODUCTION
#
#  Copier en .env sur le serveur, puis : npm run preflight
#  Ce fichier-ci est un modele : les secrets ci-dessous ont ete generes
#  pour vous, mais REGENEREZ-LES si ce fichier a transite quelque part.
# =====================================================================

NODE_ENV=production
PORT=3210

# LE reglage le plus facile a oublier : il compose les URL d'images
# envoyees aux sites clients. Reste sur localhost = images cassees partout,
# sans aucune erreur visible.
BASE_URL=https://restockdesk.com

# Obligatoire derriere nginx / Caddy, sinon la limite de debit voit
# toutes les requetes venir du proxy.
TRUST_PROXY=true

# ---- Base de donnees -------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fourseason
DB_PASSWORD=tzhubxNZjj7Xh8e-pvhdbZRx
DB_NAME=fourseason
# utilise uniquement par docker-compose
DB_ROOT_PASSWORD=5F2qtm7YF0WnRPmJroqSbA1i

# ---- Gemini ----------------------------------------------------------
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---- Stockage --------------------------------------------------------
# DOIT etre un volume persistant et sauvegarde : sur un disque ephemere,
# toutes les images generees disparaissent au redeploiement.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# ---- Securite --------------------------------------------------------
# Signe les cookies de session de la console et hache les IP des prospects.
SESSION_SECRET=vAcxuoFrcL-EPRWmqnXqQgdKXtpIJIrqLQ_FTDwJ1qR7YsIiXhpSlheIh4EF-PpS

# ---- Garde-fou budget ------------------------------------------------
BUDGET_HARD_LIMIT_EUR=90

# Ce VPS heberge deja d'autres applications Node : verifiez qu'aucune
# n'occupe le port ci-dessus  ->  sudo ss -tlnp | grep 3210

# ---- Worker ----------------------------------------------------------
# false en production : le worker tourne dans son propre processus.
WORKER_INLINE=false
WORKER_CONCURRENCY=4

# ---- NE PAS AJOUTER --------------------------------------------------
# ALLOW_PRIVATE_IMAGE_HOSTS n'a rien a faire ici. Ce drapeau desactive le
# garde-fou SSRF : il permettrait a un client de nous faire lire les
# metadonnees de l'hebergeur, donc ses identifiants.
