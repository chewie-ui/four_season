# ---- Serveur ----
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# ---- Base de donnees MySQL ----
# Laisser vide tant que MySQL n'est pas installe : le site vitrine tourne sans.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---- Google Gemini (generation d'images) ----
# Cle a creer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---- Stockage des images ----
# local | s3  (on commence en local, on bascule sur S3/Infomaniak Swiss Backup plus tard)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# ---- Securite ----
SESSION_SECRET=change_me_avec_une_longue_chaine_aleatoire

# ---- Garde-fou budget ----
# Stoppe les generations au-dela de ce montant cumule (en euros), pour proteger les 100 EUR de test
BUDGET_HARD_LIMIT_EUR=90

# ---- Worker ----
# true = le worker tourne dans le processus du serveur (pratique en dev).
# En production, le lancer separement : npm run worker
WORKER_INLINE=true
# Nombre de generations traitees en parallele (1-12).
WORKER_CONCURRENCY=4

# DEV UNIQUEMENT : autorise les images servies depuis localhost.
# Doit rester false (ou absent) en production -> faille SSRF sinon.
ALLOW_PRIVATE_IMAGE_HOSTS=false
