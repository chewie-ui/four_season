<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="principal">
  <section class="section">
    <div class="enveloppe centre" style="max-width:52ch">
      <p class="etiquette" style="justify-content:center">Erreur 500</p>
      <h2>Quelque chose s&rsquo;est mal pass&eacute; chez nous.</h2>
      <p class="chapo centre">L&rsquo;incident est enregistr&eacute;. Si cela se reproduit, &eacute;crivez-nous.</p>
      <div class="pile mt-2" style="justify-content:center">
        <a class="btn btn-or" href="/">Retour &agrave; l&rsquo;accueil</a>
        <a class="btn btn-vide" href="/contact">Nous pr&eacute;venir</a>
      </div>
    </div>
  </section>
  <% if (typeof detail !== 'undefined' && detail) { %>
    <div class="enveloppe">
      <pre class="pre-code" style="white-space:pre-wrap;font-size:.78rem;max-width:100%"><%= detail %></pre>
    </div>
  <% } %>
</main>
<%- include('../partials/footer') %>
