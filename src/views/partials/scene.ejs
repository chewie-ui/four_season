<%
  /* Scène paramétrique : la MÊME maison, redessinée par de simples variables CSS.
     `sid` rend les identifiants uniques quand la scène apparaît plusieurs fois. */
  const s = typeof sid !== 'undefined' ? sid : 'sc';
%>
<svg class="scene" viewBox="0 0 800 460" preserveAspectRatio="xMidYMid slice"
     xmlns="http://www.w3.org/2000/svg"
     style="<%= typeof rootStyle !== 'undefined' ? rootStyle : '' %>"
     role="img" aria-label="Maison représentée dans différentes ambiances" focusable="false">
  <%# Le CSS contient `syntax: '<color>'` (@property). Servi en image/svg+xml,
      le fichier est parsé en XML strict : sans CDATA, ce `<color>` est lu comme
      une balise ouvrante et tout le document est rejeté. Les navigateurs sont
      parfois indulgents, librsvg et les convertisseurs ne le sont pas. %>
  <% if (typeof inlineCss !== 'undefined' && inlineCss) { %><style>/*<![CDATA[*/<%- inlineCss %>/*]]>*/</style><% } %>
  <defs>
    <linearGradient id="<%= s %>-sky" x1="0" y1="0" x2="0" y2="1">
      <stop class="sky-a" offset="0"/>
      <stop class="sky-b" offset="1"/>
    </linearGradient>
    <radialGradient id="<%= s %>-halo">
      <stop class="halo-a" offset="0"/>
      <stop class="halo-b" offset="0.45"/>
      <stop class="halo-c" offset="1"/>
    </radialGradient>
    <linearGradient id="<%= s %>-fog" x1="0" y1="0" x2="0" y2="1">
      <stop class="fog-a" offset="0"/>
      <stop class="fog-b" offset="0.55"/>
      <stop class="fog-c" offset="1"/>
    </linearGradient>
    <linearGradient id="<%= s %>-win" x1="0" y1="0" x2="0" y2="1">
      <stop class="win-a" offset="0"/>
      <stop class="win-b" offset="1"/>
    </linearGradient>
    <clipPath id="<%= s %>-frame"><rect x="0" y="0" width="800" height="460"/></clipPath>
  </defs>

  <g clip-path="url(#<%= s %>-frame)">
    <rect class="sky" x="0" y="0" width="800" height="460" fill="url(#<%= s %>-sky)"/>

    <!-- étoiles -->
    <g class="stars">
      <circle cx="88"  cy="58"  r="1.7"/><circle cx="176" cy="112" r="1.1"/>
      <circle cx="262" cy="46"  r="1.5"/><circle cx="330" cy="130" r="1"/>
      <circle cx="418" cy="70"  r="1.9"/><circle cx="486" cy="34"  r="1.2"/>
      <circle cx="556" cy="118" r="1.4"/><circle cx="640" cy="62"  r="1.7"/>
      <circle cx="712" cy="140" r="1.1"/><circle cx="760" cy="46"  r="1.5"/>
      <circle cx="140" cy="176" r="1"/>  <circle cx="600" cy="180" r="1.2"/>
      <circle cx="380" cy="200" r=".9"/> <circle cx="248" cy="212" r="1.1"/>
    </g>

    <!-- l'astre et son halo : une seule translation, pilotée par les variables
         de position du soleil (double tiret interdit dans un commentaire XML) -->
    <g class="sun">
      <circle class="sun-halo" cx="0" cy="0" r="300" fill="url(#<%= s %>-halo)"/>
      <circle class="sun-core" cx="0" cy="0" r="30"/>
    </g>

    <!-- lointain -->
    <path class="hills" d="M0 322 C 120 292, 210 336, 318 318 C 430 300, 520 338, 636 314 C 712 298, 764 320, 800 310 L800 460 L0 460 Z"/>
    <g class="treeline">
      <path d="M60 322 l16-40 16 40z"/><path d="M96 324 l13-32 13 32z"/>
      <path d="M700 316 l17-44 17 44z"/><path d="M736 318 l13-34 13 34z"/>
      <path d="M148 326 l11-27 11 27z"/><path d="M664 320 l11-28 11 28z"/>
    </g>

    <rect class="ground" x="0" y="330" width="800" height="130"/>

    <!-- allée -->
    <path class="path" d="M392 350 L432 350 L500 460 L336 460 Z"/>

    <!-- maison -->
    <g class="house">
      <rect class="chimney" x="474" y="172" width="26" height="62"/>
      <rect class="wall" x="300" y="232" width="220" height="108"/>
      <polygon class="roof" points="410,146 556,234 264,234"/>
      <rect class="terrace" x="268" y="338" width="284" height="12"/>

      <g class="windows">
        <rect class="win" x="325" y="258" width="48" height="48" rx="2" fill="url(#<%= s %>-win)"/>
        <rect class="win" x="447" y="258" width="48" height="48" rx="2" fill="url(#<%= s %>-win)"/>
        <path class="mullion" d="M349 258 v48 M325 282 h48 M471 258 v48 M447 282 h48"/>
      </g>
      <rect class="door" x="386" y="284" width="48" height="56" rx="3"/>
      <circle class="knob" cx="425" cy="313" r="2.4"/>

      <!-- lumière projetée par les fenêtres sur la terrasse -->
      <g class="spill">
        <polygon points="325,306 373,306 391,350 307,350"/>
        <polygon points="447,306 495,306 513,350 429,350"/>
      </g>
    </g>

    <!-- végétation -->
    <g class="tree">
      <rect class="trunk" x="626" y="266" width="17" height="76" rx="3"/>
      <circle class="canopy" cx="634" cy="238" r="47"/>
      <circle class="canopy alt" cx="603" cy="262" r="33"/>
      <circle class="canopy alt" cx="667" cy="260" r="35"/>
    </g>
    <g class="bush">
      <ellipse class="canopy" cx="228" cy="336" rx="48" ry="23"/>
      <ellipse class="canopy alt" cx="180" cy="342" rx="30" ry="16"/>
    </g>

    <!-- floraison de printemps -->
    <g class="blossom">
      <circle cx="612" cy="216" r="4"/><circle cx="650" cy="226" r="3.4"/>
      <circle cx="628" cy="252" r="3"/><circle cx="596" cy="250" r="3.6"/>
      <circle cx="664" cy="246" r="3"/><circle cx="640" cy="204" r="3.4"/>
      <circle cx="212" cy="326" r="3.2"/><circle cx="246" cy="332" r="2.8"/>
    </g>

    <!-- neige accumulée : elle suit la géométrie réelle du toit et du sol -->
    <g class="snowpack">
      <rect x="0" y="330" width="800" height="130"/>
      <polygon points="410,150 548,233 519,233 410,167 301,233 272,233"/>
      <rect x="472" y="169" width="30" height="9" rx="3"/>
      <ellipse cx="228" cy="322" rx="44" ry="12"/>
      <ellipse cx="634" cy="204" rx="34" ry="11"/>
    </g>

    <!-- précipitations -->
    <g class="rain">
      <% for (let i = 0; i < 46; i++) {
           const x = (i * 173) % 820 - 10, d = ((i * 37) % 90) / 100; %>
        <line x1="<%= x %>" y1="-30" x2="<%= x - 9 %>" y2="6" style="animation-delay:<%= d %>s"/>
      <% } %>
    </g>
    <g class="flakes">
      <% for (let i = 0; i < 40; i++) {
           const x = (i * 199) % 800, d = ((i * 61) % 300) / 100, r = 1.6 + ((i * 7) % 20) / 10; %>
        <circle cx="<%= x %>" cy="-20" r="<%= r %>" style="animation-delay:<%= -d %>s"/>
      <% } %>
    </g>

    <rect class="fog" x="0" y="120" width="800" height="340" fill="url(#<%= s %>-fog)"/>
    <rect class="vignette" x="0" y="0" width="800" height="460"/>
  </g>
</svg>
